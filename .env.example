# Application Environment
APP_ENV=development
APP_NAME="MODIS-VIIRS Hotspot Harmonisation"
DEFAULT_METHOD_VERSION=1.0.0

# Backend FastAPI Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_ORIGIN=http://localhost:3000
MAX_UPLOAD_SIZE_MB=50

# Database & PostGIS Configuration
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/modis_viirs_harmonisation
TEST_DATABASE_URL=sqlite:///./test_harmonisation.db

# Frontend Next.js Configuration
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api
NEXT_PUBLIC_DEFAULT_CRS=EPSG:4326
